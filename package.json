{
  "name": "naqsh",
  "private": true,
  "license": "MIT",
  "description": "Open-source relief-carving CAD/CAM (working title: Naqsh)",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @naqsh/app dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "pnpm --filter @naqsh/app test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
